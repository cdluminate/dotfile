[core]
	editor = vim
	quotepath = false
[user]
	name = Mo Zhou
	email = cdluminate@gmail.com
	editor = vim
[push]
	default = simple
[alias]
	co = checkout
	br = branch
	st = status
	stu = status -uno
	l  = log --stat --show-signature --graph --date=iso
	hist = log --oneline --graph --show-signature
	sub = submodule
	cl = clean -xdf
	w = worktree
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[color]
	ui = true
[credential]
	helper = cache --timeout=1800
