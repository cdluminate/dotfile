# 1. Prepare
# sudo apt install sbuild mmdebstrap piuparts lintian autopkgtest
# mkdir -p ~/.cache/sbuild

# [amd64]
# mmdebstrap --skip=output/dev --variant=buildd --include=ca-certificates,eatmydata --include=ccache --customize-hook='chroot "$1" update-ccache-symlinks' --components=main,contrib,non-free,non-free-firmware --arch amd64 unstable ~/.cache/sbuild/unstable-amd64.tar.zst http://t490/

# [arm64]
# mmdebstrap --skip=output/dev --variant=buildd --include=ca-certificates,eatmydata --include=ccache --customize-hook='chroot "$1" update-ccache-symlinks' --components=main,contrib,non-free,non-free-firmware --arch arm64 unstable ~/.cache/sbuild/unstable-arm64.tar.zst http://t490/

# [ports]
# sudo apt install -y debian-ports-archive-keyring
# mmdebstrap --skip=output/dev --variant=buildd --arch hppa --include=ca-certificates,eatmydata,debian-ports-archive-keyring unstable ~/.cache/sbuild/unstable-hppa.tar.zst http://ftp.ports.debian.org/debian-ports/
# mmdebstrap --skip=output/dev --variant=buildd --arch alpha --include=ca-certificates,eatmydata,debian-ports-archive-keyring unstable ~/.cache/sbuild/unstable-alpha.tar.zst http://ftp.ports.debian.org/debian-ports/

# 2. Copy this config file to ~/.sbuildrc
# 3. build package
# sbuild --no-clean -c unstable-amd64 --build amd64 --arch amd64 .

# --- general sbuild settings
$chroot_mode = 'unshare';
$purge_build_directory = 'always';

# --- this is for rpi's nvme setup
# mkdir -p /nvme/dot-cache/sbuild/tmp
# chmod 777 /nvme/dot-cache/sbuild/tmp
#$unshare_tmpdir_template = "$ENV{HOME}/.cache/sbuild/tmp/tmp.sbuild.XXXXXXXXXX";
if (-d "/nvme/dot-cache/sbuild/tmp") {
    $unshare_tmpdir_template = "/nvme/dot-cache/sbuild/tmp/tmp.sbuild.XXXXXXXXXX";
}

$external_commands = { "build-failed-commands" => [ [ '%SBUILD_SHELL' ] ] };

# --- use my local mirror
if ($distribution eq 'unstable') {
    push @{$extra_repositories}, 'deb http://t490 sid main contrib non-free non-free-firmware';
}

# --- setup eatmydata
if ($host_arch eq 'amd64') {
    $external_commands = {
        'chroot-setup-commands' => [ "export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libeatmydata.so" ]
    };
    $build_environment->{"LD_PRELOAD"} = "/usr/lib/x86_64-linux-gnu/libeatmydata.so";
    $environment_filter=[Dpkg::BuildInfo::get_build_env_allowed(), '^LD_PRELOAD$'];
} elsif ($host_arch eq 'arm64') {
    $external_commands = {
        'chroot-setup-commands' => [ "export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libeatmydata.so" ]
    };
    $build_environment->{"LD_PRELOAD"} = "/usr/lib/aarch64-linux-gnu/libeatmydata.so";
    $environment_filter=[Dpkg::BuildInfo::get_build_env_allowed(), '^LD_PRELOAD$'];
}

# --- setup ccache
# mkdir -p $HOME/.cache/ccache
# chmod a+X "$HOME" "$HOME/.cache"
# chmod -R a+rwX "$HOME/.cache/ccache"
$build_environment->{"CCACHE_DIR"} = "/build/ccache";
$path = "/usr/lib/ccache:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games";
$unshare_bind_mounts = [ { directory => "$HOME/.cache/ccache", mountpoint => "/build/ccache" } ];

# --- lintian
$run_lintian = 1;
$lintian_opts = ['-E', '-v', '-i', '-I'];

# --- autopkgtest
$run_autopkgtest = 1;

# --- piuparts
#$run_piuparts = 1;
